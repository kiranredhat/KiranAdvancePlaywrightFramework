{
  "name": "kiranadvanceplaywrightframework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:debug": "playwright test --debug",
    "test:e2e": "playwright test tests/e2e",
    "test:po": "playwright test tests/page-objects",
    "test:report": "playwright test --reporter=html && npx playwright show-report",
    "test:p1": "playwright test --grep @p1",
    "test:report:ci": "CI=1 playwright test --reporter=html,json",
    "log:sample": "node -e \"const winston=require('winston'); const logger=winston.createLogger({ transports:[ new winston.transports.Console({ format:winston.format.combine(winston.format.colorize(), winston.format.simple()) }) ]}); logger.info('Sample Winston log');\"",
    "lint": "eslint . --ext .ts",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "format": "prettier --write .",
    "build": "tsc --project tsconfig.json",
    "clean": "rimraf node_modules/.cache playwright-report test-results .eslintcache logs",
    "check": "npm run lint && npm run type-check && npm run format -- --check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "allure-playwright": "^3.14.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5"
  }
}
